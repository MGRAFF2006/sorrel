# Source-built pilot. This does not upgrade the published alpha binaries.
SORREL_VERSION=0.1.0-alpha.2
SORREL_HUB_HOST=hub.example.com
SORREL_HUB_PUBLIC_URL=https://hub.example.com
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
SORREL_HUB_TRUSTED_GRANTS_FILE=/app/config/grants.json
SORREL_BIND_ADDRESS=127.0.0.1
SORREL_HUB_MAX_BODY_BYTES=67108864
# Only for the optional existing-Cloudflare-Tunnel overlay:
# SORREL_TUNNEL_NETWORK=existing-tunnel-network
# SORREL_HUB_DATA_PATH=/path/to/persistent/hub-data
