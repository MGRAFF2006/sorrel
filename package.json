{
  "name": "sorrel",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "Sorrel monorepo — agent-native VCS and full-stack E2E happy path.",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup-workspace.mjs",
    "dev": "node scripts/dev-dashboard.mjs",
    "dashboard": "node scripts/dev-dashboard.mjs",
    "check": "npm run check:quick && npm run check:rust && npm run test:modules && npm test",
    "check:quick": "npm run validate:release && npm run test:release && npm run validate:conformance && npm run validate:docs && npm run test:changelogs",
    "check:rust": "cargo clippy --workspace --all-targets -- -D warnings && cargo fmt --all -- --check",
    "test": "node tests/e2e/happy-path.mjs",
    "test:e2e": "node tests/e2e/happy-path.mjs",
    "test:modules": "node tests/e2e/run-module-tests.mjs",
    "test:module": "node tests/e2e/run-module-tests.mjs",
    "validate:release": "node scripts/check-release.mjs",
    "test:release": "node --test scripts/check-release.test.mjs",
    "validate:conformance": "./scripts/sync-conformance.sh --check",
    "validate:docs": "node scripts/sync-docs.mjs --check && node scripts/check-doc-links.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:changelogs": "node scripts/prepare-changelogs.mjs",
    "test:changelogs": "node --test scripts/prepare-changelogs.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
