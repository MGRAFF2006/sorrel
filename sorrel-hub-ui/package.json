{
  "name": "sorrel-hub-ui",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "Shared SolidJS Hub product UI for browser, desktop, and mobile shells.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MGRAFF2006/sorrel.git",
    "directory": "sorrel-hub-ui"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx"
    },
    "./styles.css": "./src/styles/hub.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "check": "npm test && npm run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/*.test.mjs && vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "convex": "^1.25.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.2.0",
    "jsdom": "^30.0.1",
    "solid-js": "^1.9.5",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.0": true,
    "esbuild@0.25.12": true
  }
}
