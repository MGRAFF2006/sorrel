{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sorrel.dev/vault/sorrel-secrets.v0.schema.json",
  "title": "sorrel.secrets.yml",
  "description": "Draft schema for Sorrel secret references, local development imports, redaction, and access grants.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "project",
    "environments",
    "secretRefs",
    "grants",
    "localDev",
    "redaction"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "#/$defs/VaultSpecVersion"
    },
    "kind": {
      "const": "SecretSpec"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/Environment"
      }
    },
    "secretRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/SecretRef"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SecretGrant"
      }
    },
    "localDev": {
      "$ref": "#/$defs/LocalDevBackend"
    },
    "redaction": {
      "$ref": "#/$defs/RedactionPolicy"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    }
  },
  "$defs": {
    "VaultSpecVersion": {
      "type": "string",
      "const": "sorrel.vault.v0"
    },
    "ProtocolVersion": {
      "type": "string",
      "const": "sorrel.protocol.v0"
    },
    "ObjectId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]*$"
    },
    "Kind": {
      "type": "string",
      "enum": [
        "SecretRef",
        "Workflow",
        "Runner",
        "Policy",
        "AgentPolicy"
      ]
    },
    "ObjectRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        }
      }
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "repo",
            "path",
            "lane",
            "stack",
            "slice",
            "workflow",
            "runner",
            "secret",
            "environment",
            "project"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        ]
      }
    },
    "Project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "repo": {
          "$ref": "#/$defs/Scope"
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "Environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "classification"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "classification": {
          "type": "string",
          "enum": [
            "local",
            "shared",
            "protected"
          ]
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "policy": {
          "$ref": "#/$defs/ObjectRef"
        },
        "runnerAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectRef"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        }
      }
    },
    "SecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "name",
        "provider",
        "uri",
        "environment",
        "required",
        "valueType"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "kind": {
          "const": "SecretRef"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "provider": {
          "type": "string",
          "enum": [
            "sorrel-vault"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^secret://"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "required": {
          "type": "boolean"
        },
        "valueType": {
          "type": "string",
          "enum": [
            "secret",
            "url",
            "token",
            "certificate",
            "key",
            "json",
            "text"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scope"
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "rotation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cadence": {
              "type": "string",
              "enum": [
                "manual",
                "daily",
                "weekly",
                "monthly",
                "quarterly",
                "yearly"
              ]
            },
            "lastRotatedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
            }
          }
        },
        "description": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "redaction": {
          "$ref": "#/$defs/RedactionMarker"
        }
      }
    },
    "SecretGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "secret",
        "environment",
        "actions",
        "access"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "secret": {
          "allOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "SecretRef"
                }
              }
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "read",
              "materialize",
              "import",
              "redact"
            ]
          },
          "uniqueItems": true
        },
        "access": {
          "$ref": "#/$defs/GrantAccess"
        },
        "policy": {
          "allOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "Policy"
                }
              }
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
      }
    },
    "GrantAccess": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ObjectRef"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "AgentPolicy"
                  }
                }
              }
            ]
          },
          "uniqueItems": true
        },
        "workflows": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ObjectRef"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "Workflow"
                  }
                }
              }
            ]
          },
          "uniqueItems": true
        },
        "runners": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/ObjectRef"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "Runner"
                  }
                }
              }
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "LocalDevBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "import",
        "storage",
        "bindings"
      ],
      "properties": {
        "backend": {
          "const": "local-dev"
        },
        "import": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "envFiles",
            "defaultKeyStrategy",
            "allowProcessEnvFallback"
          ],
          "properties": {
            "envFiles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/EnvFileImport"
              }
            },
            "defaultKeyStrategy": {
              "type": "string",
              "enum": [
                "secretRefName"
              ]
            },
            "allowProcessEnvFallback": {
              "type": "boolean"
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "persist"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "persist": {
              "type": "boolean"
            },
            "materialize": {
              "type": "string",
              "enum": [
                "environment",
                "file",
                "none"
              ]
            }
          }
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/LocalSecretBinding"
          }
        }
      }
    },
    "EnvFileImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "environment"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "LocalSecretBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret",
        "environment",
        "envKey",
        "storeKey"
      ],
      "properties": {
        "secret": {
          "allOf": [
            {
              "$ref": "#/$defs/ObjectRef"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "SecretRef"
                }
              }
            }
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "envKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "storeKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "RedactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mask",
        "minSecretLength",
        "visiblePrefix",
        "visibleSuffix",
        "detectEnvKeys"
      ],
      "properties": {
        "mask": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "minSecretLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "visiblePrefix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "visibleSuffix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "detectEnvKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "ResourceKind": {
      "type": "string",
      "enum": [
        "org",
        "project",
        "repo",
        "path",
        "file",
        "symbol",
        "change",
        "stack",
        "proposal",
        "comment-thread",
        "secret",
        "environment",
        "agent",
        "runner",
        "workflow",
        "marketplace-app"
      ]
    },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "RedactionMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "id",
        "resource",
        "marker",
        "reason"
      ],
      "properties": {
        "schemaVersion": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "kind": {
          "const": "RedactionMarker"
        },
        "id": {
          "$ref": "#/$defs/ObjectId"
        },
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "visiblePrefix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "visibleSuffix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        }
      }
    }
  }
}
